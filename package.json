{
  "name": "invite-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:telnyx-webrtc-security": "node --test scripts/test-telnyx-webrtc-security.mjs",
    "test:inbound-bridge-idempotency": "node --test scripts/test-inbound-bridge-idempotency.mjs",
    "test:inbound-bridge-mongo": "node --test scripts/test-inbound-bridge-mongo.mjs",
    "test:invitation-guest-writes": "npx tsx --test scripts/test-invitation-guest-writes.ts",

    "staging:seed": "npx tsx scripts/staging/seed-staging-fixtures.ts",
    "staging:isolation": "node -e \"fetch(process.env.STAGING_URL+'/api/system/env-isolation',{headers:process.env.VERCEL_AUTOMATION_BYPASS_SECRET?{'x-vercel-protection-bypass':process.env.VERCEL_AUTOMATION_BYPASS_SECRET}:{}}).then(r=>r.json()).then(j=>{console.log(JSON.stringify(j,null,2)); if(!j.ok) process.exit(1)})\"",
    "test:venues": "node --test scripts/tests/venue-*.test.mjs && npx tsx --test --test-force-exit scripts/tests/venue-e2e-memory.test.ts",
    "test:venues:db": "node --test scripts/tests/venue-db-isolation.test.mjs",
    "test:venues:e2e": "npx tsx --test --test-force-exit scripts/tests/venue-e2e-memory.test.ts",
    "test:producer-impersonation": "npx tsx --test --test-force-exit scripts/tests/producer-nested-impersonation.test.ts",
    "test:venues:staging-live": "node scripts/staging/run-staging-venues-e2e.mjs",
    "test:venue-safety": "node scripts/ci/venue-pr-protected-core-guard.mjs && node --test scripts/tests/venue-safety-contract.test.mjs scripts/tests/venue-regular-boundary.test.mjs scripts/tests/regular-customer-event-access.test.mjs scripts/tests/venue-day-of-and-pilot.test.mjs scripts/tests/venue-complete-gate.test.mjs scripts/tests/venue-client-seating-upsert.test.mjs scripts/tests/venue-pilot-and-gate.test.mjs",
    "test:venues:full-scale-lab": "node scripts/staging/run-full-scale-venue-lab.mjs",
    "venues:backfill:dry": "npx tsx scripts/venues/backfill-venue-event-links.ts",
    "venues:backfill:write": "npx tsx scripts/venues/backfill-venue-event-links.ts --write",
    "venues:check-cloudinary-env": "node scripts/venues/check-cloudinary-env.mjs"
  },

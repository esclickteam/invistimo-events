{
  "expo": {
    "name": "Invistimo",
    "slug": "invistimo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "invistimo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.invistimo.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSContactsUsageDescription": "Invistimo ניגש לאנשי הקשר רק כדי שתוכלו לבחור מוזמנים לייבוא. לא נשלחת כל רשימת אנשי הקשר.",
        "NSCameraUsageDescription": "Invistimo משתמש במצלמה כדי לסרוק קוד QR בכניסה לאירוע.",
        "NSFaceIDUsageDescription": "Invistimo משתמש ב-Face ID כדי לפתוח את הסשן השמור במכשיר. הסיסמה לא נשמרת."
      }
    },
    "android": {
      "package": "com.invistimo.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/invistimo-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF8F4"
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Invistimo משתמש ב-Face ID כדי לפתוח את הסשן השמור במכשיר. הסיסמה לא נשמרת."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Invistimo ניגש לאנשי הקשר רק כדי שתוכלו לבחור מוזמנים לייבוא. לא נשלחת כל רשימת אנשי הקשר."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Invistimo משתמש במצלמה כדי לסרוק קוד QR בכניסה לאירוע.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B88A2D",
          "defaultChannel": "invistimo",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://www.invistimo.com",
      "eas": {}
    }
  }
}

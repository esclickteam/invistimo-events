{
  "name": "digital-album",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "prisma generate && next build",
    "start": "next start --port 3010",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:photos": "tsx scripts/seed-demo-photos.ts",
    "db:reset": "prisma migrate reset --force && tsx scripts/seed.ts && tsx scripts/seed-demo-photos.ts",
    "jobs:process": "tsx -e \"import('./src/lib/jobs.ts').then(m=>m.processNextJobs(20).then(console.log))\"",
    "test:acceptance": "node scripts/acceptance.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "framer-motion": "^14.6.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
